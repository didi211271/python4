filename = input("Введите имя файла с расширением:")
extension = filename.split('.')[-1].lower()
if extension == 'doc':
    print("Word file")
elif extension == 'py':
    print("Python file")
elif extension == 'txt':
    print("Text file")
else:
    print("Неизвестное расширение")

3
a = float(input("Введите первую строку:"))
b = float(input("Введите вторую строку:"))
c = float(input("Введите третью строку:"))
if a <= 0 or b <= 0 or c <= 0:
    print("Стороны должны быть положительными!")
elif a + b <= c or a + c <= b or b + c <= a:
    print("Такого треугольника не существует!")
else:
    if a == b == c:
        print("Равносторонний")
    elif a == b or b == c or a == c:
        print("Равнобедренный")
    else:
        print("Разностороний")

